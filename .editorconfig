# EditorConfig helps maintain consistent coding styles for multiple developers working on the same project
# across various editors and IDEs (VSCode, Android Studio, IntelliJ, etc.).
# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Dart
[*.dart]
indent_style = space
indent_size = 2

# C / C++ / Objective-C
[*.{c,cpp,h,m,mm}]
indent_style = space
indent_size = 4

# Kotlin / Java
[*.{kt,java}]
indent_style = space
indent_size = 4

# CMake
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

# Gradle / Groovy
[*.{gradle,gradle.kts}]
indent_style = space
indent_size = 4

# GLSL / Impeller Shader
[*.{frag,vert,glsl}]
indent_style = space
indent_size = 4

# YAML / JSON / XML / Markdown
[*.{yaml,yml,json,xml,md}]
indent_style = space
indent_size = 2

# Windows batch files
[*.{bat,cmd}]
end_of_line = crlf
