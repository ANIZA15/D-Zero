# Auto-detect text files and normalize line endings to LF (Mac, Linux, and Windows cross-platform uniformity)
* text=auto eol=lf

# Explicit text files
*.dart text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.m text eol=lf
*.mm text eol=lf
*.swift text eol=lf
*.frag text eol=lf
*.vert text eol=lf
*.glsl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.podspec text eol=lf
Podfile text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.pubignore text eol=lf
LICENSE text eol=lf

# Windows-specific script files that require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (do not touch line endings or content)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.ts binary
*.so binary
*.dylib binary
*.dll binary
*.jar binary
*.aab binary
*.apk binary
