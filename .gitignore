# =============================================================================
# Package Example Local Platform Scaffolds (generated via `flutter create .`)
# =============================================================================
# Pure widget packages only track example/lib, pubspec.yaml, analysis_options.yaml, and README.md.
packages/*/example/.gitignore
packages/*/example/.metadata
packages/*/example/android/
packages/*/example/ios/
packages/*/example/macos/
packages/*/example/linux/
packages/*/example/windows/
packages/*/example/web/
packages/*/example/test/

